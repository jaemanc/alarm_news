# Alarm News System - Environment Configuration Template
# Copy this file to .env and fill in your actual values

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=alarm_news
MONGODB_MIN_POOL_SIZE=10
MONGODB_MAX_POOL_SIZE=100

# Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_NOTIFICATION_TOPIC=notification-events
KAFKA_EMAIL_TOPIC=email-delivery
KAFKA_DLQ_TOPIC=notification-dlq
KAFKA_CONSUMER_GROUP_WORKER=alarm-news-workers
KAFKA_CONSUMER_GROUP_EMAIL=alarm-news-email-workers

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=noreply@alarmnews.com
SMTP_FROM_NAME=Alarm News

# Authentication Configuration
JWT_SECRET=your-secret-key-change-this-in-production
JWT_EXPIRY_HOURS=24
BCRYPT_COST_FACTOR=12

# Rate Limiting Configuration
RATE_LIMIT_MAX_ATTEMPTS=5
RATE_LIMIT_WINDOW_MINUTES=15

# Crawler Configuration
CRAWLER_INTERVAL_MINUTES=30
CRAWLER_REQUEST_DELAY_SECONDS=2
CRAWLER_REQUEST_TIMEOUT_SECONDS=30
CRAWLER_USER_AGENTS=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36

# Scheduler Configuration
SCHEDULER_USER_RELOAD_MINUTES=5
SCHEDULER_EVALUATION_INTERVAL_SECONDS=60

# Worker Configuration
WORKER_ID=worker-1
WORKER_LOCK_TTL_SECONDS=300
WORKER_LOCK_TIMEOUT_SECONDS=10
WORKER_SHUTDOWN_GRACE_PERIOD_SECONDS=60

# Health Check Configuration
HEALTH_CHECK_TIMEOUT_SECONDS=5
HEALTH_CHECK_INACTIVITY_THRESHOLD_MINUTES=5

# Logging Configuration
LOG_LEVEL=INFO
LOG_FORMAT=json
