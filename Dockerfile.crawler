# Dockerfile for Alarm News Web Crawler
# Required environment variables:
#   MONGODB_URI - MongoDB connection string
#   REDIS_HOST - Redis server host
#   REDIS_PORT - Redis server port
#   CRAWLER_INTERVAL_MINUTES - Crawl interval in minutes
#   CRAWLER_REQUEST_DELAY_SECONDS - Delay between requests

FROM python:3.9-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && \
    apt-get install -y --no-install-recommends gcc libffi-dev && \
    rm -rf /var/lib/apt/lists/*

# Copy and install Python dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy source code
COPY src/ ./src/
COPY setup.py .

# Create non-root user
RUN useradd --create-home --uid 1000 appuser
USER appuser

# Set environment variables with defaults
ENV MONGODB_URI=mongodb://mongodb:27017 \
    MONGODB_DATABASE=alarm_news \
    REDIS_HOST=redis \
    REDIS_PORT=6379 \
    CRAWLER_INTERVAL_MINUTES=30 \
    CRAWLER_REQUEST_DELAY_SECONDS=2 \
    CRAWLER_REQUEST_TIMEOUT_SECONDS=30 \
    LOG_LEVEL=INFO \
    LOG_FORMAT=json \
    HEALTH_CHECK_TIMEOUT_SECONDS=5

EXPOSE 8080

CMD ["python", "-m", "src.crawler"]
