# Dockerfile for Alarm News Scheduler
# Required environment variables:
#   MONGODB_URI - MongoDB connection string
#   KAFKA_BOOTSTRAP_SERVERS - Kafka broker addresses
#   REDIS_HOST - Redis server host
#   REDIS_PORT - Redis server port
#   SCHEDULER_USER_RELOAD_MINUTES - User data reload interval
#   SCHEDULER_EVALUATION_INTERVAL_SECONDS - Notification evaluation interval

FROM python:3.9-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && \
    apt-get install -y --no-install-recommends gcc libffi-dev && \
    rm -rf /var/lib/apt/lists/*

# Copy and install Python dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir --trusted-host pypi.org --trusted-host pypi.python.org --trusted-host files.pythonhosted.org -r requirements.txt

# Copy source code
COPY src/ ./src/
COPY setup.py .

# Create non-root user
RUN useradd --create-home --uid 1000 appuser
USER appuser

# Set environment variables with defaults
ENV MONGODB_URI=mongodb://mongodb:27017 \
    MONGODB_DATABASE=alarm_news \
    KAFKA_BOOTSTRAP_SERVERS=kafka:9092 \
    KAFKA_NOTIFICATION_TOPIC=notification-events \
    REDIS_HOST=redis \
    REDIS_PORT=6379 \
    SCHEDULER_USER_RELOAD_MINUTES=5 \
    SCHEDULER_EVALUATION_INTERVAL_SECONDS=60 \
    LOG_LEVEL=INFO \
    LOG_FORMAT=json \
    HEALTH_CHECK_TIMEOUT_SECONDS=5

EXPOSE 8080

CMD ["python", "-m", "src.scheduler.main"]
